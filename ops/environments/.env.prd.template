# Production Environment Configuration
# Copy this file to .env.prd and fill in actual values
# NEVER commit .env.prd with real secrets!

# Database Configuration
# JDBC URL without credentials
JDBC_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Database credentials (get from Supabase Dashboard → Settings → Database)
DB_USER=postgres.XXXXXX
DB_PASS=YOUR_PASSWORD

# Spring Boot Profile
SPRING_PROFILES_ACTIVE=prd
