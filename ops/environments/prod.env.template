# Production Environment Configuration
# Copy this file to prod.env and fill in actual values
# NEVER commit prod.env with real secrets!

# Supabase JDBC URL (Session Pooler with embedded credentials)
# Get this from: Supabase Dashboard → Settings → Database → Connection String
# Select "Session pooler" mode and copy the JDBC URL
# Format: jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?user=postgres.XXXXXX&password=YOUR_PASSWORD
JDBC_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?user=postgres.XXXXXX&password=YOUR_PASSWORD

# Spring Boot Profile
SPRING_PROFILES_ACTIVE=prd
