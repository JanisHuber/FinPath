# ===========================================
# FinPath Root .gitignore
# ===========================================

# === Node / Frontend ===
node_modules/
dist/
www/
.angular/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.lockb
.bun/

# === Java / Maven ===
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# === IDE / Editor ===
.idea/
.vscode/
*.iml
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
.c9/
*.launch

# === OS Files ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# === Environment & Secrets ===
.env
.env.*
!.env.*.template
*.key
*.pem
*.p12
*.pfx
*credentials*.json
*secret*.json
finpath-firebase*.json

# === Database ===
*.sqlite
*.sqlite3
*.db
# SQL dumps (but NOT supabase migrations)
/dumps/
*.dump.sql
*_dump.sql
*_backup.sql

# === Supabase ===
# Migrations ARE tracked - don't ignore them!
# supabase/.gitignore handles internal temp files

# === Docker ===
.docker/

# === Build & Test ===
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
__screenshots__/

# === Capacitor Native (if building locally) ===
# Remove these if you want to track native code
/apps/finpath-frontend-mobile/ios/
/apps/finpath-frontend-mobile/android/

# === Ops Secrets ===
/ops/secrets/
!/ops/secrets/*.template

# === Temp & Cache ===
*.swp
*.swo
*.tmp
*.temp
*~
.cache/
.parcel-cache/
.turbo/

# === Logs ===
logs/
*.log
firebase-debug.log
